# Dados brutos, intermediários e processados (exceto manifesto de hashes e .gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/raw/manifesto_hashes.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
dist/
build/
.venv/
venv/
ENV/

# Testes e ferramentas
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Quarto / Jupyter
.quarto/
*_files/
.ipynb_checkpoints/
mlruns/

# Documentos finais confidenciais / acadêmicos privados (mantidos apenas localmente)
*.pdf
reports/*.pdf
*.log
.env
.env.*

